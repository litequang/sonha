# =========================================================================
# Firebase Configuration (.env.local hoặc .env)
# Hệ thống ưu tiên 100% các biến trong file .env.local khi chạy build hoặc dev tại máy.
# Hỗ trợ cả định dạng VITE_FIREBASE_* lẫn FIREBASE_*.
# =========================================================================

# Khóa API từ Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Database ID của Cloud Firestore (Mặc định để trống hoặc '(default)')
VITE_FIREBASE_DATABASE_ID=
